{
  "name": "jimothy-simulator",
  "productName": "Jimothy Simulator",
  "version": "0.1.0",
  "description": "Jimothy Simulator: a physics sandbox starring Jimothy, the round raccoon of Ballard (Windows desktop / Steam build).",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "achievements": "node scripts/gen-achievements.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs",
    "build:steam": "node scripts/build-web.mjs && node scripts/make-icons.mjs && node scripts/package.mjs",
    "start": "electron .",
    "dev": "node scripts/build-web.mjs && electron .",
    "test": "node scripts/test-desktop.mjs",
    "test:dev": "node scripts/test-desktop.mjs --dev"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  }
}
